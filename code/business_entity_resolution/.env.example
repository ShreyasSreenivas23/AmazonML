# Copy to .env (gitignored) and fill in. Never commit .env.

# Data location (absolute path recommended). Code reads this; never hardcode paths.
DATA_DIR=./data
RUNS_DIR=./runs
CKPT_DIR=./checkpoints
# OOF/test predictions for ensembling (point at a synced team folder if you like)
OOF_DIR=./oof

# Monitoring / alerts
DISCORD_WEBHOOK_URL=
# Optional fallback: https://ntfy.sh/<your-private-topic>
NTFY_TOPIC_URL=

# Optional: identifies who launched a run in logs/alerts
OWNER=

# Optional: AWS (prefer `aws configure` / SSO profiles over raw keys)
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
